{
  "name": "@personal-agent/tool",
  "version": "0.1.0",
  "private": false,
  "description": "Tool execution system for personal-agent",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "echo 'lint ok'",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@personal-agent/config": "workspace:*",
    "@personal-agent/shared": "workspace:*",
    "fast-glob": "^3.3.0",
    "strip-ansi": "^7.1.0",
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/diff": "^7.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
