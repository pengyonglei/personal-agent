{
  "name": "@personal-agent/web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based streaming chat UI for personal-agent",
  "scripts": {
    "build": "tsup src/server.ts --format esm --clean --external yoga-wasm-web --external vite && vite build",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "echo lint ok",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "type": "module",
  "main": "./dist/server.js",
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@personal-agent/config": "workspace:*",
    "@personal-agent/core": "workspace:*",
    "@personal-agent/mcp": "workspace:*",
    "@personal-agent/memory": "workspace:*",
    "@personal-agent/plugin": "workspace:*",
    "@personal-agent/provider": "workspace:*",
    "@personal-agent/shared": "workspace:*",
    "@personal-agent/tool": "workspace:*",
    "antd": "6.5.2",
    "express": "^5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "8.1.5"
  }
}
