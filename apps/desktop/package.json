{
  "name": "@personal-agent/desktop",
  "productName": "Personal Agent",
  "version": "0.1.1",
  "private": true,
  "description": "Windows desktop application for personal-agent",
  "author": "personal-agent",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepare:runtime": "pnpm --filter @personal-agent/web... build",
    "start": "pnpm run prepare:runtime && pnpm run build && electron .",
    "package": "pnpm run prepare:runtime && pnpm run build && electron-forge package --platform=win32 --arch=x64",
    "make": "pnpm run prepare:runtime && pnpm run build && electron-forge make --platform=win32 --arch=x64",
    "make:arm64": "pnpm run prepare:runtime && pnpm run build && electron-forge make --platform=win32 --arch=arm64",
    "lint": "echo lint ok",
    "test": "echo test ok",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('out',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@personal-agent/web": "workspace:*",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.20.1",
    "electron": "^43.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "esbuild": "~0.27.7",
    "typescript": "^5.9.3"
  }
}
