{
  "name": "@personal-agent/desktop",
  "productName": "Personal Agent",
  "version": "0.2.0",
  "private": true,
  "description": "Windows desktop application for personal-agent",
  "author": "personal-agent",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "typecheck": "tsc --noEmit",
    "prepare:runtime": "pnpm exec turbo run build --filter=@personal-agent/web...",
    "start": "pnpm run prepare:runtime && pnpm run build && electron .",
    "package": "node scripts/release.mjs package",
    "make": "node scripts/release.mjs make",
    "make:installer": "node scripts/release.mjs make-installer",
    "make:arm64": "node scripts/release.mjs make-arm64",
    "make:installer:arm64": "node scripts/release.mjs make-installer-arm64",
    "publish": "node scripts/release.mjs publish",
    "lint": "echo lint ok",
    "test": "echo test ok",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('out',{recursive:true,force:true})\""
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@personal-agent/web": "workspace:*",
    "@types/node": "^22.20.1",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "~0.27.7",
    "typescript": "^5.9.3"
  }
}
